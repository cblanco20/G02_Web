@using System.Globalization
@model RecetaDetalleItem

@{
    ViewData["Title"] = Model.NombreReceta;
    Layout = "~/Views/Shared/_LayoutUsuario.cshtml";
}

<div class="mealprep-dashboard">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="badge bg-label-primary mb-2">@Model.NombreCategoria</span>
            <h4 class="mp-titulo-seccion mb-1">@Model.NombreReceta</h4>

            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="text-muted mb-0">@Model.Descripcion</p>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Recetas"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i>
                Volver
            </a>

            <a asp-controller="Recetas"
               asp-action="Editar"
               asp-route-id="@Model.IdReceta"
               class="btn btn-primary">
                <i class="bx bx-edit me-1"></i>
                Editar
            </a>

            <form method="post"
                  asp-controller="Recetas"
                  asp-action="Eliminar"
                  asp-route-id="@Model.IdReceta"
                  onsubmit="return confirm('¿Deseas eliminar esta receta?');">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bx bx-trash me-1"></i>
                    Eliminar
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            <i class="bx bx-time-five me-1"></i>
                            Preparación
                        </span>
                        <span class="fw-semibold">@Model.TiempoPreparacion min</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            <i class="bx bx-group me-1"></i>
                            Porciones
                        </span>
                        <span class="fw-semibold">@Model.Porciones</span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">
                            <i class="bx bx-calendar me-1"></i>
                            Creada
                        </span>
                        <span class="fw-semibold">@Model.FechaCreacion.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bx bx-basket me-2"></i>
                        Ingredientes
                    </h5>
                </div>

                <ul class="list-group list-group-flush">
                    @foreach (var ingrediente in Model.Ingredientes)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@ingrediente.NombreIngrediente</span>
                            <span class="fw-semibold">
                                @ingrediente.Cantidad.ToString("0.##", CultureInfo.CurrentCulture)
                                @ingrediente.Abreviatura
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bx bx-list-ol me-2"></i>
                        Instrucciones
                    </h5>
                </div>

                <div class="card-body">
                    <div style="white-space: pre-line;">@Model.Instrucciones</div>
                </div>
            </div>
        </div>

    </div>

</div>
