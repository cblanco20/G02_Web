@model RecetasIndexViewModel

@{
    ViewData["Title"] = "Mis recetas";
    Layout = "~/Views/Shared/_LayoutUsuario.cshtml";

    var hayFiltros = Model.IdCategoria.HasValue || !string.IsNullOrWhiteSpace(Model.Busqueda);
}

<div class="mealprep-dashboard">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h4 class="mp-titulo-seccion mb-1">
                <i class="bx bx-book-open me-2"></i>
                Mis recetas
            </h4>
            <p class="text-muted mb-0">
                Consulta, crea y organiza tu recetario personal.
            </p>
        </div>

        <a asp-controller="Recetas"
           asp-action="Crear"
           class="btn btn-primary">
            <i class="bx bx-plus me-1"></i>
            Nueva receta
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bx bx-error-circle me-2"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success" role="alert">
            <i class="bx bx-check-circle me-2"></i>
            @TempData["Exito"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get"
                  asp-controller="Recetas"
                  asp-action="Index"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label for="busqueda" class="form-label fw-semibold">Buscar por nombre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent">
                            <i class="bx bx-search"></i>
                        </span>
                        <input type="search"
                               id="busqueda"
                               name="busqueda"
                               value="@Model.Busqueda"
                               class="form-control"
                               placeholder="Ej. arroz con pollo" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="idCategoria" class="form-label fw-semibold">Categoría</label>
                    <select id="idCategoria" name="idCategoria" class="form-select">
                        <option value="">Todas las categorías</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.IdCategoria"
                                    selected="@(Model.IdCategoria == categoria.IdCategoria)">
                                @categoria.NombreCategoria
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        Filtrar
                    </button>

                    @if (hayFiltros)
                    {
                        <a asp-controller="Recetas"
                           asp-action="Index"
                           class="btn btn-outline-secondary"
                           title="Quitar filtros">
                            <i class="bx bx-x"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.Recetas.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bx bx-book-bookmark fs-1 text-muted"></i>

                @if (hayFiltros)
                {
                    <h5 class="mt-3">No se encontraron recetas</h5>
                    <p class="text-muted mb-0">Prueba con otro nombre u otra categoría.</p>
                }
                else
                {
                    <h5 class="mt-3">Aún no tienes recetas</h5>
                    <p class="text-muted">Crea tu primera receta para empezar a armar tu recetario.</p>
                    <a asp-controller="Recetas"
                       asp-action="Crear"
                       class="btn btn-primary">
                        <i class="bx bx-plus me-1"></i>
                        Crear receta
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var receta in Model.Recetas)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-label-primary">
                                    @receta.NombreCategoria
                                </span>
                                <small class="text-muted">
                                    @receta.FechaCreacion.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <h5 class="card-title mb-2">@receta.NombreReceta</h5>

                            @if (!string.IsNullOrWhiteSpace(receta.Descripcion))
                            {
                                <p class="text-muted small mb-3">@receta.Descripcion</p>
                            }

                            <div class="d-flex flex-wrap gap-3 text-muted small mb-4">
                                <span>
                                    <i class="bx bx-time-five me-1"></i>
                                    @receta.TiempoPreparacion min
                                </span>
                                <span>
                                    <i class="bx bx-group me-1"></i>
                                    @receta.Porciones porciones
                                </span>
                                <span>
                                    <i class="bx bx-basket me-1"></i>
                                    @receta.TotalIngredientes ingredientes
                                </span>
                            </div>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a asp-controller="Recetas"
                                   asp-action="Detalle"
                                   asp-route-id="@receta.IdReceta"
                                   class="btn btn-sm btn-primary">
                                    <i class="bx bx-show me-1"></i>
                                    Ver
                                </a>

                                <a asp-controller="Recetas"
                                   asp-action="Editar"
                                   asp-route-id="@receta.IdReceta"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bx bx-edit me-1"></i>
                                    Editar
                                </a>

                                <form method="post"
                                      asp-controller="Recetas"
                                      asp-action="Eliminar"
                                      asp-route-id="@receta.IdReceta"
                                      onsubmit="return confirm('¿Deseas eliminar esta receta?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bx bx-trash me-1"></i>
                                        Eliminar
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
