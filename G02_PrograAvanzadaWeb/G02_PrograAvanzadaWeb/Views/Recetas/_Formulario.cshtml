@model RecetaFormulario

@{
    var esNueva = Model.IdReceta == 0;

    var accion = esNueva
        ? Url.Action("Crear", "Recetas")
        : Url.Action("Editar", "Recetas", new { id = Model.IdReceta });

    var erroresGenerales = ViewData.ModelState.TryGetValue(string.Empty, out var entradaGeneral)
        ? entradaGeneral.Errors.Select(e => e.ErrorMessage).ToList()
        : new List<string>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h4 class="mp-titulo-seccion mb-1">
            <i class="bx bx-book-add me-2"></i>
            @(esNueva ? "Nueva receta" : "Editar receta")
        </h4>
        <p class="text-muted mb-0">
            Completa los datos de la receta y agrega sus ingredientes.
        </p>
    </div>

    <a asp-controller="Recetas"
       asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bx bx-arrow-back me-1"></i>
        Volver a mis recetas
    </a>
</div>

@if (erroresGenerales.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        @foreach (var mensaje in erroresGenerales)
        {
            <div>
                <i class="bx bx-error-circle me-1"></i>
                @mensaje
            </div>
        }
    </div>
}

<form method="post" action="@accion">

    @Html.AntiForgeryToken()

    <div class="card mb-4">
        <div class="card-body p-4">

            <div class="row g-3">

                <div class="col-md-8">
                    <label asp-for="NombreReceta" class="form-label fw-semibold">
                        Nombre de la receta
                    </label>
                    <input asp-for="NombreReceta"
                           class="form-control"
                           maxlength="150"
                           required />
                    <span asp-validation-for="NombreReceta" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="IdCategoria" class="form-label fw-semibold">
                        Categoría
                    </label>
                    <select asp-for="IdCategoria" class="form-select" required>
                        <option value="0">Seleccione una categoría</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.IdCategoria">@categoria.NombreCategoria</option>
                        }
                    </select>
                    <span asp-validation-for="IdCategoria" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TiempoPreparacion" class="form-label fw-semibold">
                        Tiempo de preparación (minutos)
                    </label>
                    <input asp-for="TiempoPreparacion"
                           type="number"
                           class="form-control"
                           min="1"
                           max="1440"
                           required />
                    <span asp-validation-for="TiempoPreparacion" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Porciones" class="form-label fw-semibold">
                        Porciones
                    </label>
                    <input asp-for="Porciones"
                           type="number"
                           class="form-control"
                           min="1"
                           max="100"
                           required />
                    <span asp-validation-for="Porciones" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label fw-semibold">
                        Descripción breve (opcional)
                    </label>
                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="2"
                              maxlength="500"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">
                <i class="bx bx-basket me-2"></i>
                Ingredientes
            </h5>

            <button type="button"
                    id="agregarIngrediente"
                    class="btn btn-sm btn-outline-primary">
                <i class="bx bx-plus me-1"></i>
                Agregar ingrediente
            </button>
        </div>

        <div class="card-body p-4">
            <div id="listaIngredientes">
                @for (int i = 0; i < Model.Ingredientes.Count; i++)
                {
                    <partial name="_FilaIngrediente"
                             model="new FilaIngredienteViewModel
                                    {
                                        Indice = i,
                                        Fila = Model.Ingredientes[i],
                                        Opciones = Model.IngredientesDisponibles
                                    }" />
                }
            </div>

            <template id="plantillaIngrediente">
                <partial name="_FilaIngrediente"
                         model="new FilaIngredienteViewModel
                                {
                                    Indice = 0,
                                    Fila = new RecetaIngredienteFormulario(),
                                    Opciones = Model.IngredientesDisponibles
                                }" />
            </template>

            <small class="text-muted">
                Las cantidades se expresan en la unidad que se muestra junto a cada ingrediente.
            </small>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bx bx-list-ol me-2"></i>
                Instrucciones
            </h5>
        </div>

        <div class="card-body p-4">
            <textarea asp-for="Instrucciones"
                      class="form-control"
                      rows="8"
                      required></textarea>
            <span asp-validation-for="Instrucciones" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="Recetas"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-primary">
            <i class="bx bx-save me-1"></i>
            @(esNueva ? "Guardar receta" : "Guardar cambios")
        </button>
    </div>

</form>
