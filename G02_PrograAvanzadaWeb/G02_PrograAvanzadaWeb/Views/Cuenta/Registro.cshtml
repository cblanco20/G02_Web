@model G02_PrograAvanzadaWeb.Models.RegistroUsuario

@{
    ViewData["Title"] = "Registro";
    Layout = "_LayoutAuth";
}

<div class="mealprep-auth-page">
    <div class="container-xxl">
        <div class="authentication-wrapper authentication-basic container-p-y">
            <div class="authentication-inner">
                <div class="card mealprep-login-card">
                    <div class="card-body">

                        <div class="mealprep-login-brand text-center">
                            <a asp-controller="Home" asp-action="Index">
                                <img src="~/img/MealPrep_logo_completo.png"
                                     alt="MealPrep"
                                     class="mealprep-login-logo" />
                            </a>
                        </div>

                        <div class="mealprep-login-header">
                            <h4>¡Crea tu cuenta!</h4>
                            <p>Regístrate para comenzar a utilizar MealPrep</p>
                        </div>

                        @if (ViewBag.Mensaje != null)
                        {
                            <div class="alert alert-danger">
                                @ViewBag.Mensaje
                            </div>
                        }

                        <form asp-controller="Cuenta"
                              asp-action="Registro"
                              method="post"
                              id="formAuthentication"
                              class="mb-3">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="NombreUsuario"
                                       class="form-label">
                                    Usuario
                                </label>

                                <input asp-for="NombreUsuario"
                                       class="form-control mealprep-auth-input"
                                       placeholder="Ingrese su usuario"
                                       autofocus />

                                <span asp-validation-for="NombreUsuario"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Correo"
                                       class="form-label">
                                    Correo electrónico
                                </label>

                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control mealprep-auth-input"
                                       placeholder="Ingrese su correo electrónico" />

                                <span asp-validation-for="Correo"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-password-toggle">
                                <label asp-for="Contrasena"
                                       class="form-label">
                                    Contraseña
                                </label>

                                <div class="input-group input-group-merge">
                                    <input asp-for="Contrasena"
                                           type="password"
                                           class="form-control mealprep-auth-input"
                                           placeholder="············" />

                                    <span class="input-group-text cursor-pointer">
                                        <i class="bx bx-hide"></i>
                                    </span>
                                </div>

                                <span asp-validation-for="Contrasena"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="AceptaTerminos"
                                           class="form-check-input"
                                           type="checkbox" />

                                    <label class="form-check-label"
                                           asp-for="AceptaTerminos">
                                        Acepto la política de privacidad
                                        y los términos y condiciones
                                    </label>
                                </div>

                                <span asp-validation-for="AceptaTerminos"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <button class="btn mealprep-login-submit d-grid w-100"
                                        type="submit">
                                    Registrarse
                                </button>
                            </div>
                        </form>

                        <p class="text-center mealprep-register-text">
                            <span>¿Ya tiene una cuenta?</span>

                            <a asp-controller="Cuenta"
                               asp-action="Login"
                               class="mealprep-auth-link">
                                <span>Iniciar sesión</span>
                            </a>
                        </p>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}