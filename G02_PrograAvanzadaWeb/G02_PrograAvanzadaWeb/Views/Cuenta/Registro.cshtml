@{
    ViewData["Title"] = "Registro";
    Layout = "_LayoutAuth";
}

<div class="mealprep-auth-page">

    <div class="container-xxl">

        <div class="authentication-wrapper authentication-basic container-p-y">

            <div class="authentication-inner">

                <div class="card mealprep-login-card">

                    <div class="card-body">

                        <div class="mealprep-login-brand text-center">

                            <a asp-controller="Home"
                               asp-action="Index">

                                <img src="~/img/MealPrep_logo_completo.png"
                                     alt="MealPrep"
                                     class="mealprep-login-logo" />

                            </a>

                        </div>

                        <div class="mealprep-login-header">

                            <h4>
                                ¡Crea tu cuenta!
                            </h4>

                            <p>
                                Regístrate para comenzar a utilizar MealPrep
                            </p>

                        </div>

                        <form id="formAuthentication"
                              class="mb-3">

                            <div class="mb-3">

                                <label for="username"
                                       class="form-label">
                                    Usuario
                                </label>

                                <input type="text"
                                       class="form-control mealprep-auth-input"
                                       id="username"
                                       name="username"
                                       placeholder="Ingrese su usuario"
                                       autofocus />

                            </div>

                            <div class="mb-3">

                                <label for="email"
                                       class="form-label">
                                    Correo electrónico
                                </label>

                                <input type="text"
                                       class="form-control mealprep-auth-input"
                                       id="email"
                                       name="email"
                                       placeholder="Ingrese su correo electrónico" />

                            </div>

                            <div class="mb-3 form-password-toggle">

                                <label class="form-label"
                                       for="password">
                                    Contraseña
                                </label>

                                <div class="input-group input-group-merge">

                                    <input type="password"
                                           id="password"
                                           class="form-control mealprep-auth-input"
                                           name="password"
                                           placeholder="············"
                                           aria-describedby="password" />

                                    <span class="input-group-text cursor-pointer">
                                        <i class="bx bx-hide"></i>
                                    </span>

                                </div>

                            </div>

                            <div class="mb-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="terms-conditions"
                                           name="terms" />

                                    <label class="form-check-label"
                                           for="terms-conditions">

                                        Acepto la
                                        <a href="javascript:void(0);"
                                           class="mealprep-auth-link">
                                            política de privacidad y los términos
                                        </a>

                                    </label>

                                </div>

                            </div>

                            <div class="mb-3">

                                <button class="btn mealprep-login-submit d-grid w-100"
                                        type="button">
                                    Registrarse
                                </button>

                            </div>

                        </form>

                        <p class="text-center mealprep-register-text">

                            <span>
                                ¿Ya tiene una cuenta?
                            </span>

                            <a asp-controller="Cuenta"
                               asp-action="Login"
                               class="mealprep-auth-link">

                                <span>
                                    Iniciar sesión
                                </span>

                            </a>

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>