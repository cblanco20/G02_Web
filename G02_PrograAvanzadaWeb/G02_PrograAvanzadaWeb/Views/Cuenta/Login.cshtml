@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
}

<div class="mealprep-auth-page">

    <div class="container-xxl">

        <div class="authentication-wrapper authentication-basic container-p-y">

            <div class="authentication-inner">

                <!-- LOGIN -->
                <div class="card mealprep-login-card">

                    <div class="card-body">

                        <!-- Logo MealPrep -->
                        <div class="mealprep-login-brand text-center">

                            <a asp-controller="Home"
                               asp-action="Index">

                                <img src="~/img/MealPrep_logo_completo.png"
                                     alt="MealPrep"
                                     class="mealprep-login-logo" />

                            </a>

                        </div>

                        <!-- Bienvenida -->
                        <div class="mealprep-login-header">

                            <h4>
                                ¡Bienvenido a MealPrep! 
                            </h4>

                            <p>
                                Inicia sesión en tu cuenta para continuar
                            </p>

                        </div>


                        <form id="formAuthentication"
                              class="mb-3">

                            <!-- Correo o usuario -->
                            <div class="mb-3">

                                <label for="email"
                                       class="form-label">

                                    Correo o usuario

                                </label>

                                <input type="text"
                                       class="form-control mealprep-auth-input"
                                       id="email"
                                       name="email-username"
                                       placeholder="Ingrese su correo o usuario"
                                       autofocus />

                            </div>


                            <!-- Contraseña -->
                            <div class="mb-3 form-password-toggle">

                                <div class="d-flex justify-content-between">

                                    <label class="form-label"
                                           for="password">

                                        Contraseña

                                    </label>

                                    <a asp-controller="Cuenta"
                                       asp-action="RecuperarAcceso"
                                       class="mealprep-auth-link">

                                        <small>
                                            ¿Olvidó su contraseña?
                                        </small>

                                    </a>

                                </div>


                                <div class="input-group input-group-merge">

                                    <input type="password"
                                           id="password"
                                           class="form-control mealprep-auth-input"
                                           name="password"
                                           placeholder="············"
                                           aria-describedby="password" />

                                    <span class="input-group-text cursor-pointer">

                                        <i class="bx bx-hide"></i>

                                    </span>

                                </div>

                            </div>


                            <!-- Recordarme -->
                            <div class="mb-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="remember-me" />

                                    <label class="form-check-label"
                                           for="remember-me">

                                        Recordarme

                                    </label>

                                </div>

                            </div>


                            <!-- Botón -->
                            <div class="mb-3">

                                <button class="btn mealprep-login-submit d-grid w-100"
                                        type="button">

                                    Iniciar sesión

                                </button>

                            </div>

                        </form>


                        <!-- Crear cuenta -->
                        <p class="text-center mealprep-register-text">

                            <span>
                                ¿Aún no tiene una cuenta?
                            </span>

                            <a asp-controller="Cuenta"
                               asp-action="Registro"
                               class="mealprep-auth-link">

                                <span>
                                    Crear una cuenta
                                </span>

                            </a>

                        </p>

                    </div>

                </div>
               

            </div>

        </div>

    </div>

</div>