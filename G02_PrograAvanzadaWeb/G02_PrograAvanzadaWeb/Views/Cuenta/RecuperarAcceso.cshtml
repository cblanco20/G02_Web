@{
    ViewData["Title"] = "Recuperar acceso";
    Layout = "_LayoutAuth";
}

<div class="mealprep-auth-page">

    <div class="container-xxl">

        <div class="authentication-wrapper authentication-basic container-p-y">

            <div class="authentication-inner">

                <div class="card mealprep-login-card">

                    <div class="card-body">

                        <div class="mealprep-login-brand text-center">

                            <a asp-controller="Home"
                               asp-action="Index">

                                <img src="~/img/MealPrep_logo_completo.png"
                                     alt="MealPrep"
                                     class="mealprep-login-logo" />

                            </a>

                        </div>

                        <div class="mealprep-login-header">

                            <h4>
                                ¿Olvidó su contraseña?
                            </h4>

                            <p>
                                Ingrese su correo electrónico y le enviaremos las instrucciones para restablecer su contraseña.
                            </p>

                        </div>

                        <form id="formAuthentication"
                              class="mb-3">

                            <div class="mb-3">

                                <label for="email"
                                       class="form-label">
                                    Correo electrónico
                                </label>

                                <input type="text"
                                       class="form-control mealprep-auth-input"
                                       id="email"
                                       name="email"
                                       placeholder="Ingrese su correo electrónico"
                                       autofocus />

                            </div>

                            <div class="mb-3">

                                <button class="btn mealprep-login-submit d-grid w-100"
                                        type="button">

                                    Enviar enlace de recuperación

                                </button>

                            </div>

                        </form>

                        <div class="text-center">

                            <a asp-controller="Cuenta"
                               asp-action="Login"
                               class="mealprep-auth-link d-flex align-items-center justify-content-center">

                                <i class="bx bx-chevron-left scaleX-n1-rtl bx-sm"></i>

                                Volver a iniciar sesión

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>