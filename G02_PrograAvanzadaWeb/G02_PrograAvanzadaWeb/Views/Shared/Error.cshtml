@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h1 class="text-danger">Ocurrió un problema</h1>
    <p class="lead">No pudimos completar tu solicitud. Inténtalo de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            Código de referencia: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>
