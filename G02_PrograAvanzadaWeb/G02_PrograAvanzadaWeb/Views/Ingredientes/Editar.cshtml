@model IngredienteFormulario

@{
    ViewData["Title"] = "Editar ingrediente";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var erroresGenerales = ViewData.ModelState.TryGetValue(string.Empty, out var entradaGeneral)
        ? entradaGeneral.Errors.Select(e => e.ErrorMessage).ToList()
        : new List<string>();
}

<div class="mealprep-dashboard">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h4 class="mp-titulo-seccion mb-1">
                <i class="bx bx-edit me-2"></i>
                Editar ingrediente
            </h4>
            <p class="text-muted mb-0">
                La unidad no se puede cambiar si el ingrediente ya se usa en recetas.
            </p>
        </div>

        <a asp-controller="Ingredientes"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bx bx-arrow-back me-1"></i>
            Volver
        </a>
    </div>

    @if (erroresGenerales.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var mensaje in erroresGenerales)
            {
                <div>
                    <i class="bx bx-error-circle me-1"></i>
                    @mensaje
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="card-body p-4">
            <form method="post"
                  asp-controller="Ingredientes"
                  asp-action="Editar"
                  asp-route-id="@Model.IdIngrediente">

                <div class="mb-3">
                    <label asp-for="NombreIngrediente" class="form-label fw-semibold">
                        Nombre
                    </label>
                    <input asp-for="NombreIngrediente"
                           class="form-control"
                           maxlength="150"
                           required />
                    <span asp-validation-for="NombreIngrediente" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="IdUnidad" class="form-label fw-semibold">
                        Unidad de medida
                    </label>
                    <select asp-for="IdUnidad" class="form-select" required>
                        <option value="0">Seleccione una unidad</option>
                        @foreach (var unidad in Model.Unidades)
                        {
                            <option value="@unidad.IdUnidad">
                                @unidad.NombreUnidad (@unidad.Abreviatura)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="IdUnidad" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Ingredientes"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
